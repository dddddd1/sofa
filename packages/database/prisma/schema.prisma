// ============================================================================
// Harper Cloud · Modular Sofa DTC — P0 Prisma Schema
// 对应文档：《P0 技术架构方案 v1.0》第 5 章 数据模型
//
// 约定：
//  1. 金额一律用 Int 存最小货币单位（USD 分），字段名 *_minor，并配 currency 列；
//  2. 方案/报价/BOM 等不可变内容用 Jsonb 快照存，禁止就地更新历史记录；
//  3. id 统一 cuid（对用户暴露的编号另用 humanNo / token）；
//  4. 所有表带 createdAt / updatedAt；业务表加 deletedAt 软删除标记（按需）。
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// 枚举
// ---------------------------------------------------------------------------

enum SeriesStatus {
  draft
  active
  archived
}

enum ModuleType {
  laf_seat      // 左扶手座（序列起点端头）
  raf_seat      // 右扶手座（序列终点端头）
  armless_seat  // 无扶手中座
  corner        // 转角（每套至多 1）
  chaise        // 贵妃榻（端头）
  console       // 控制台
  ottoman       // 脚凳（可作端头）
}

enum CoverGradeKey {
  fabric
  performance
  leather_match
  top_grain
  full_grain
}

enum LegKey {
  natural
  walnut
  metal
}

enum QuoteStatus {
  valid
  expired
  consumed // 已被订单冻结
}

enum CartStatus {
  open
  merged   // 匿名车合并到登录车后
  converted
  abandoned
}

enum OrderStatus {
  pending_payment
  paid_pending_erp // 支付成功、工厂工单未确认
  confirmed        // ERP 接单，生产中窗口开始
  in_production
  ready
  shipped
  delivered
  cancelling       // 48h 取消窗口内申请中
  cancelled
  refunded
}

enum PaymentProvider {
  stripe
  paypal
}

enum PaymentStatus {
  created
  processing
  succeeded
  failed
  canceled
  refunded
}

enum FulfillmentState {
  confirmed
  in_production
  ready
  shipped
  delivered
}

enum ArAssetStatus {
  queued
  processing
  ready
  failed
}

enum AdminRole {
  owner
  merchant_editor // 商品/价格
  ops             // 订单/履约
  viewer
}

// ---------------------------------------------------------------------------
// Catalog 商品域
// ---------------------------------------------------------------------------

model Series {
  id                String            @id @default(cuid())
  slug              String            @unique
  name              String
  status            SeriesStatus      @default(draft)
  assetManifestUrl  String            @map("asset_manifest_url")
  assetVersion      String            @default("1.0.0") @map("asset_version")
  basePriceMinor    Int               @map("base_price_minor") // 基准价：无扶手座 + fabric
  currency          String            @default("USD")
  leadTimeWeeksMin  Int               @map("lead_time_weeks_min")
  leadTimeWeeksMax  Int               @map("lead_time_weeks_max")
  dimensionsCatalog Json?             @map("dimensions_catalog") // 模块/模板尺寸汇总，供前台快速展示
  seoTitle          String?           @map("seo_title")
  seoDescription    String?           @map("seo_description")

  modules     ModuleDef[]
  grades      CoverGrade[]
  legOptions  SeriesLegOption[]
  templates   ConfigurationTemplate[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt      @map("updated_at")

  @@map("series")
}

model ModuleDef {
  id               String     @id @default(cuid())
  seriesId         String     @map("series_id")
  code             String     // 例：HC-LAF-01；major 改版必须用新 code
  type             ModuleType
  name             String
  status           SeriesStatus @default(draft)
  assetUrl         String     @map("asset_url")
  assetVersion     String     @default("1.0.0") @map("asset_version")
  dimensionsM      Json       @map("dimensions_m") // {w,d,h} 米
  sockets          String[]   // ["socket_left","socket_right"]
  powerCompatible  Boolean    @default(false) @map("power_compatible")
  coverMask        String     @default("body_all") @map("cover_mask")
  basePriceMinor   Int        @map("base_price_minor") // 该模块 fabric 基准价
  powerAddonMinor  Int        @default(0) @map("power_addon_minor")
  sortOrder        Int        @default(0) @map("sort_order")

  series    Series                @relation(fields: [seriesId], references: [id])
  bomLines  QuoteBomLine[]
  orderItems OrderItemModule[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt      @map("updated_at")

  @@unique([seriesId, code])
  @@index([seriesId, status])
  @@map("module_def")
}

model CoverGrade {
  id           String         @id @default(cuid())
  seriesId     String         @map("series_id")
  gradeKey     CoverGradeKey  @map("grade_key")
  name         String         // "Performance Fabric"
  priceFactor  Decimal        @map("price_factor") @db.Decimal(5, 3) // 1.000 / 1.150 ...
  assetPackUrl String?        @map("asset_pack_url") // 共享材质包（KTX2）
  tint         Boolean        @default(true) // 织物 true；皮革 false（逐色贴图）
  swatchOrder  Int            @default(0) @map("swatch_order")

  series    Series      @relation(fields: [seriesId], references: [id])
  colorways Colorway[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt      @map("updated_at")

  @@unique([seriesId, gradeKey])
  @@map("cover_grade")
}

model Colorway {
  id           String   @id @default(cuid())
  gradeId      String   @map("grade_id")
  slug         String   // "fog"
  name         String   // "Fog"
  srgb         String   // "#B9B3AA"，与 3D tint 同一来源
  tintStrength Float    @default(1.0) @map("tint_strength")
  leatherTexUrl String? @map("leather_tex_url") // 仅 tint=false 的皮革使用
  millSku      String   @map("mill_sku") // 工厂染整编号
  deltaE       Float?   @map("delta_e") // 3D 目标色与实物对样偏差
  swatchImage  String?  @map("swatch_image")
  active       Boolean  @default(true)

  grade CoverGrade @relation(fields: [gradeId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt      @map("updated_at")

  @@unique([gradeId, slug])
  @@map("colorway")
}

model SeriesLegOption {
  id            String  @id @default(cuid())
  seriesId      String  @map("series_id")
  legKey        LegKey  @map("leg_key")
  name          String
  assetUrl      String? @map("asset_url") // natural 可为 null（内置于模块）
  priceAddonMinor Int   @default(0) @map("price_addon_minor")

  series Series @relation(fields: [seriesId], references: [id])

  @@unique([seriesId, legKey])
  @@map("series_leg_option")
}

/// 预置模板（PRD：模板起步 → 可继续编辑为自由方案）
model ConfigurationTemplate {
  id          String  @id @default(cuid())
  seriesId    String  @map("series_id")
  slug        String  // "l-sectional-4"
  name        String
  description String?
  designJson  Json    @map("design_json") // 与运行时 Design JSON 同构（不含价格）
  sortOrder   Int     @default(0) @map("sort_order")
  active      Boolean @default(true)

  series Series @relation(fields: [seriesId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt      @map("updated_at")

  @@unique([seriesId, slug])
  @@map("configuration_template")
}

// ---------------------------------------------------------------------------
// Configuration 方案域
// ---------------------------------------------------------------------------

model Customer {
  id            String  @id @default(cuid())
  email         String  @unique
  displayName   String? @map("display_name")
  acceptsMarketing Boolean @default(false) @map("accepts_marketing")
  // Auth.js 账号关联（magic link 为主，凭证由 Auth.js 表管理，这里只存业务档案）
  lastLoginAt   DateTime? @map("last_login_at")

  designs Design[]
  carts   Cart[]
  orders  Order[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt      @map("updated_at")

  @@index([email])
  @@map("customer")
}

model Design {
  id                String   @id @default(cuid())
  customerId        String?  @map("customer_id") // 未登录草稿可为空
  schemaVersion     Int      @default(1) @map("schema_version")
  seriesId          String   @map("series_id")
  templateId        String?  @map("template_id")
  snapshot          Json     // Design JSON 原样（items/cover/leg）
  clientFingerprint String?  @map("client_fingerprint") // 未登录设备标识（IndexedDB 同步用）

  customer   Customer?    @relation(fields: [customerId], references: [id])
  quotes     DesignQuote[]
  shareLinks ShareLink[]
  cartItems  CartItem[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt      @map("updated_at")

  @@index([customerId, updatedAt])
  @@index([clientFingerprint])
  @@map("design")
}

model DesignQuote {
  id               String      @id @default(cuid())
  designId         String      @map("design_id")
  snapshotHash     String      @map("snapshot_hash") // 规范化 JSON 哈希，报价/AR 缓存复用
  schemaVersion    Int         @map("schema_version")
  status           QuoteStatus @default(valid)
  priceTableVersion String     @map("price_table_version")
  region           String      @default("US")
  currency         String      @default("USD")

  valid          Boolean
  violations     Json        // [{level:"block",index:1,code:"ENDPOINT_OPEN",...}]
  layout         Json?       // [{moduleCode,x,z,rotationY}]
  dimensionsM    Json?       @map("dimensions_m")
  bom            Json?       // QuoteBomLine[] 快照
  priceSnapshot  Json        @map("price_snapshot") // {subtotal,shipping,tax,total,feeDetails}

  expiresAt  DateTime  @map("expires_at")
  consumedAt DateTime? @map("consumed_at")

  design     Design      @relation(fields: [designId], references: [id])
  bomLines   QuoteBomLine[]
  cartItems  CartItem[]
  orderItems OrderItem[]

  createdAt DateTime @default(now()) @map("created_at")

  @@index([designId, createdAt])
  @@index([snapshotHash, region, status])
  @@map("design_quote")
}

/// BOM 行（结构化拆出，便于推工厂与统计；同时整体快照进 design_quote.bom）
model QuoteBomLine {
  id          String    @id @default(cuid())
  quoteId     String    @map("quote_id")
  moduleDefId String    @map("module_def_id")
  moduleCode  String    @map("module_code")
  quantity    Int       @default(1)
  power       Boolean   @default(false)
  coverGrade  CoverGradeKey @map("cover_grade")
  colorwaySlug String   @map("colorway_slug")
  legKey      LegKey    @map("leg_key")
  unitPriceMinor Int    @map("unit_price_minor")

  quote     DesignQuote @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  moduleDef ModuleDef    @relation(fields: [moduleDefId], references: [id])

  @@unique([quoteId, moduleDefId, power])
  @@map("quote_bom_line")
}

model ShareLink {
  id         String    @id @default(cuid())
  designId   String    @map("design_id")
  token      String    @unique // 随机不可猜，分享 URL 用
  viewCount  Int       @default(0) @map("view_count")
  revokedAt  DateTime? @map("revoked_at")

  design    Design   @relation(fields: [designId], references: [id])
  createdAt DateTime @default(now()) @map("created_at")

  @@index([designId])
  @@map("share_link")
}

// ---------------------------------------------------------------------------
// Transaction 交易域
// ---------------------------------------------------------------------------

model Cart {
  id          String     @id @default(cuid())
  customerId  String?    @map("customer_id")
  anonToken   String?    @unique @map("anon_token") // 匿名购物车 cookie
  status      CartStatus @default(open)
  currency    String     @default("USD")
  version     Int        @default(1) // 每次变更 +1，作为支付幂等键组成部分
  mergedIntoId String?   @map("merged_into_id")

  customer   Customer?  @relation(fields: [customerId], references: [id])
  items      CartItem[]
  mergedInto Cart?      @relation("CartMerge", fields: [mergedIntoId], references: [id])
  mergedFrom Cart[]     @relation("CartMerge")
  orders     Order[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt      @map("updated_at")

  @@index([customerId, status])
  @@map("cart")
}

model CartItem {
  id           String   @id @default(cuid())
  cartId       String   @map("cart_id")
  designId     String   @map("design_id")
  quoteId      String   @map("quote_id")
  designSnapshot Json   @map("design_snapshot") // 加入时快照，防止设计后改影响购物车
  quantity     Int      @default(1)
  unitPriceMinor Int?   @map("unit_price_minor") // 加入时展示价；结算以重算报价为准

  cart   Cart        @relation(fields: [cartId], references: [id], onDelete: Cascade)
  design Design      @relation(fields: [designId], references: [id])
  quote  DesignQuote @relation(fields: [quoteId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt      @map("updated_at")

  @@unique([cartId, designId])
  @@map("cart_item")
}

model Order {
  id             String      @id @default(cuid())
  humanNo        String      @unique @map("human_no") // HC-100001
  customerId     String      @map("customer_id")
  cartId         String?     @map("cart_id")
  idempotencyKey String      @unique @map("idempotency_key")
  status         OrderStatus @default(pending_payment)

  currency       String      @default("USD")
  totals         Json        // {subtotal, shipping, tax, total, feeDetails, priceTableVersion}
  shippingAddress Json       @map("shipping_address")
  billingAddress  Json       @map("billing_address")
  shippingService String?    @map("shipping_service") // white_glove | economy
  finalSaleAcknowledgedAt DateTime @map("final_sale_acknowledged_at")

  customerEmail String @map("customer_email") // 结账邮箱快照（即使无账号）
  cancelWindowEndsAt DateTime? @map("cancel_window_ends_at") // confirmed + 48h

  customer Customer      @relation(fields: [customerId], references: [id])
  cart     Cart?         @relation(fields: [cartId], references: [id])
  items    OrderItem[]
  payments Payment[]
  fulfillment Fulfillment?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt      @map("updated_at")

  @@index([customerId, createdAt])
  @@index([status])
  @@map("order")
}

model OrderItem {
  id              String  @id @default(cuid())
  orderId         String  @map("order_id")
  quoteId         String  @map("quote_id")
  designSnapshot  Json    @map("design_snapshot")
  bomSnapshot     Json    @map("bom_snapshot")
  seriesSlug      String  @map("series_slug")
  summary         String  // "L-Sectional · 4 modules · Fog / Fabric"
  unitPriceMinor  Int     @map("unit_price_minor")
  quantity        Int     @default(1)

  modules  OrderItemModule[]
  order    Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  quote    DesignQuote @relation(fields: [quoteId], references: [id])

  @@map("order_item")
}

/// 订单行内模块明细（推 ERP 的结构化数据，快照性质）
model OrderItemModule {
  id           String         @id @default(cuid())
  orderItemId  String         @map("order_item_id")
  moduleDefId  String?        @map("module_def_id") // 若模块以后下架仍保留 code 文本
  moduleCode   String         @map("module_code")
  power        Boolean        @default(false)
  coverGrade   CoverGradeKey  @map("cover_grade")
  colorwaySlug String         @map("colorway_slug")
  millSku      String?        @map("mill_sku")
  legKey       LegKey         @map("leg_key")

  orderItem OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  moduleDef ModuleDef? @relation(fields: [moduleDefId], references: [id])

  @@map("order_item_module")
}

model Payment {
  id              String          @id @default(cuid())
  orderId         String          @map("order_id")
  provider        PaymentProvider
  providerRef     String          @map("provider_ref") // pi_xxx / PayPal order id
  providerEventId String?         @unique @map("provider_event_id") // webhook 幂等去重
  status          PaymentStatus   @default(created)
  amountMinor     Int             @map("amount_minor")
  currency        String          @default("USD")
  rawWebhook      Json?           @map("raw_webhook")
  failureReason   String?         @map("failure_reason")

  order     Order     @relation(fields: [orderId], references: [id])
  paidAt    DateTime? @map("paid_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt      @map("updated_at")

  @@index([orderId, status])
  @@index([provider, providerRef])
  @@map("payment")
}

model Fulfillment {
  id           String            @id @default(cuid())
  orderId      String            @unique @map("order_id")
  state        FulfillmentState @default(confirmed)
  carrier      String?
  trackingNo   String?           @map("tracking_no")
  trackingUrl  String?           @map("tracking_url")
  erpOrderRef  String?           @map("erp_order_ref")
  estimatedDeliveryFrom DateTime? @map("estimated_delivery_from")
  estimatedDeliveryTo   DateTime? @map("estimated_delivery_to")

  order  Order               @relation(fields: [orderId], references: [id])
  events FulfillmentEvent[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt      @map("updated_at")

  @@map("fulfillment")
}

model FulfillmentEvent {
  id            String           @id @default(cuid())
  fulfillmentId String           @map("fulfillment_id")
  state         FulfillmentState
  note          String?
  source        String           @default("erp") // erp | admin | carrier_webhook
  occurredAt    DateTime         @map("occurred_at")

  fulfillment Fulfillment @relation(fields: [fulfillmentId], references: [id], onDelete: Cascade)

  @@index([fulfillmentId, occurredAt])
  @@map("fulfillment_event")
}

// ---------------------------------------------------------------------------
// Platform 平台域
// ---------------------------------------------------------------------------

model ShippingRate {
  id             String  @id @default(cuid())
  zone           String  // US-CONUS | US-AK-HI
  service        String  // white_glove | economy
  thresholdMinor Int     @map("threshold_minor") // 满额门槛（分）
  feeMinor       Int     @map("fee_minor")
  active         Boolean @default(true)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt      @map("updated_at")

  @@unique([zone, service, thresholdMinor])
  @@map("shipping_rate")
}

/// 价格表版本：改价即新增版本；报价/订单永远绑定生成时版本
model PriceTable {
  id        String   @id @default(cuid())
  version   String   @unique // "2026-09-21-01"
  currency  String   @default("USD")
  published Boolean  @default(false)
  publishedAt DateTime? @map("published_at")

  createdAt DateTime @default(now()) @map("created_at")

  @@map("price_table")
}

model TaxProviderLog {
  id           String   @id @default(cuid())
  quoteId      String?  @map("quote_id")
  orderId      String?  @map("order_id")
  provider     String   @default("avalara")
  requestBody  Json     @map("request_body")
  responseBody Json     @map("response_body")
  amountMinor  Int?     @map("amount_minor")
  docCode      String?  @map("doc_code") // Avalara transaction code

  createdAt DateTime @default(now()) @map("created_at")

  @@index([orderId])
  @@index([quoteId])
  @@map("tax_provider_log")
}

model ArAssetCache {
  id           String        @id @default(cuid())
  snapshotHash String        @unique @map("snapshot_hash")
  status       ArAssetStatus @default(queued)
  usdzUrl      String?       @map("usdz_url")
  gltfUrl      String?       @map("gltf_url")
  usdzBytes    Int?          @map("usdz_bytes")
  lodUsed      String?       @map("lod_used") // lod1 降级时记录
  errorMessage String?       @map("error_message")
  attempts     Int           @default(0)
  workerLease  DateTime?     @map("worker_lease")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt      @map("updated_at")

  @@index([status, workerLease])
  @@map("ar_asset_cache")
}

model AdminUser {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String
  role          AdminRole @default(viewer)
  mfaSecret     String?   @map("mfa_secret")
  mfaEnrolledAt DateTime? @map("mfa_enrolled_at")
  ipAllowlist   String[]  @map("ip_allowlist") // 空数组表示不限制（owner 决定）
  active        Boolean   @default(true)
  lastLoginAt   DateTime? @map("last_login_at")

  auditLogs AuditLog[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt      @map("updated_at")

  @@map("admin_user")
}

model AuditLog {
  id          String   @id @default(cuid())
  adminUserId String?  @map("admin_user_id")
  action      String   // "price.update" | "module.publish" | "order.rerun_erp"
  entityType  String   @map("entity_type")
  entityId    String   @map("entity_id")
  before      Json?
  after       Json?
  ip          String?

  adminUser AdminUser? @relation(fields: [adminUserId], references: [id])
  createdAt DateTime    @default(now()) @map("created_at")

  @@index([entityType, entityId])
  @@index([adminUserId, createdAt])
  @@map("audit_log")
}
