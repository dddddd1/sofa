{
  "version": 2,
  "functions": {
    "api/index.ts": {
      "runtime": "nodejs20.x"
    }
  },
  "installCommand": "cd ../.. && pnpm install --frozen-lockfile",
  "buildCommand": "cd ../.. && pnpm --filter @harper/database prisma:generate && pnpm -r --filter './packages/*' build",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index.ts"
    }
  ]
}