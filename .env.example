# 复制为 .env 后按需修改；.env 不入库

# --- database (docker-compose) ---
DATABASE_URL="postgresql://harper:harper_dev@localhost:5432/harper?schema=public"

# --- api ---
NODE_ENV=development
API_PORT=3001
API_HOST=0.0.0.0

# --- redis ---
REDIS_URL="redis://localhost:6379"

# --- s3 / minio（W2 资产服务启用）---
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_ACCESS_KEY_ID="harper"
S3_SECRET_ACCESS_KEY="harper_dev"
S3_BUCKET="harper-assets"

# --- 第三方（W1 全部留空，/validate 不依赖）---
STRIPE_SECRET_KEY=""
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""
AVALARA_ACCOUNT_ID=""
AVALARA_LICENSE_KEY=""
