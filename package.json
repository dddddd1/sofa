{
  "name": "harper-cloud",
  "version": "0.1.0",
  "private": true,
  "description": "Modular sofa DTC — P0 monorepo",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "build": "pnpm -r --filter=./packages/* build",
    "test": "pnpm -r --filter=./packages/* test",
    "typecheck": "pnpm -r typecheck",
    "dev:api": "pnpm --filter @harper/api start:dev",
    "db:up": "docker compose up -d",
    "db:migrate": "pnpm --filter @harper/database prisma:migrate",
    "db:seed": "pnpm --filter @harper/database seed",
    "prisma": "pnpm --filter @harper/database exec prisma"
  },
  "devDependencies": {
    "typescript": "^5.5.4"
  }
}
